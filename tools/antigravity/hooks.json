{
  "PreToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        { "type": "command", "command": "@KIT_HOOKS@/agent-adapter.sh antigravity pre", "timeout": 30 }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "run_command",
      "hooks": [
        { "type": "command", "command": "@KIT_HOOKS@/agent-adapter.sh antigravity post", "timeout": 10 }
      ]
    }
  ],
  "Stop": [
    { "type": "command", "command": "@KIT_HOOKS@/agent-adapter.sh antigravity stop", "timeout": 300 }
  ]
}
